# Server environment (server/.env)
DATABASE_URL=postgresql://user:pass@localhost:5432/trucking
# Required in production. Use a different database/branch for each environment.
DATABASE_ENVIRONMENT=development
# Production enforces the environment label automatically. Enable locally/CI
# to refuse accidental connections to a database labeled production.
DATABASE_SAFETY_ENFORCED=false
# Emergency-only local override; keep false for normal development.
ALLOW_PRODUCTION_DATABASE_IN_DEVELOPMENT=false
# Render and Railway normally place one reverse proxy in front of Express.
TRUST_PROXY_HOPS=1
PORT=3001
# must include the landing origin
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Public CRM origin used to create secure customer quote links.
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_QUOTE_SUBMISSIONS_ENABLED=true
# Same-origin Render/Railway deployments should keep lax. Use none only when
# the browser UI and API are hosted on different sites.
AUTH_COOKIE_SAME_SITE=lax

# GPT shipment advice. The model recommends equipment and operational checks;
# deterministic CRM capacity rules validate the choice before carrier APIs run.
OPENAI_API_KEY=
OPENAI_SHIPMENT_MODEL=gpt-5.6-terra
OPENAI_SHIPMENT_ADVISOR_ENABLED=true

# Parses shipment details from incoming quote emails.
OPENROUTER_API_KEY=
OPENROUTER_EMAIL_MODEL=meta-llama/llama-3.1-8b-instruct

# ExpediteAll production rating API. Keep the API key server-side only.
EXPEDITEALL_BASE_URL=https://api.expediteall.com/api/v2
EXPEDITEALL_API_KEY=

# Google Workspace quote inbox (OAuth 2.0, Gmail read-only)
GMAIL_QUOTE_MAILBOX=emailbot@optimation.io
# Recommended locally: download the Google Desktop app client as server/credentials.json.
GMAIL_CREDENTIALS_FILE=./credentials.json
# Environment variables are an alternative to credentials.json (recommended in production).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=http://127.0.0.1:53682/oauth2callback
GMAIL_POLL_ENABLED=true
GMAIL_POLL_INTERVAL_MS=60000
GMAIL_POLL_BATCH_SIZE=25
GMAIL_QUOTE_QUERY=to:emailbot@optimation.io in:inbox newer_than:30d
# Set true only when emailbot@optimation.io is an alias of the OAuth account.
GMAIL_ALLOW_MAILBOX_ALIAS=false

# Separate Gmail account used to send quote replies via a configured send-as
# alias. Leave GMAIL_SEND_CLIENT_ID / GMAIL_SEND_CLIENT_SECRET blank to reuse
# the OAuth client above; the refresh token must belong to the sending account.
GMAIL_SEND_CLIENT_ID=
GMAIL_SEND_CLIENT_SECRET=
GMAIL_SEND_REFRESH_TOKEN=
# The real Gmail account authorized to send (used as login_hint and to
# validate the OAuth binding). Example: replybot@optimation.io
GMAIL_SEND_ACCOUNT=
# The send-as alias that appears in the outgoing From: header. Must be
# configured as a "Send mail as" alias on GMAIL_SEND_ACCOUNT in Gmail settings.
# When blank, replies are sent from GMAIL_SEND_ACCOUNT (or the inbox mailbox
# if GMAIL_SEND_* is not configured).
GMAIL_SEND_FROM_ADDRESS=
# Optional display name for the send-as From: header.
GMAIL_SEND_FROM_NAME=

# Optional signed webhook alternative for inbound email providers.
INBOUND_EMAIL_SECRET=

# DAT RateView local-worker queue. Keep the secret server-side only and use
# the same value in the local worker's automation/.env file.
DAT_WORKER_ENABLED=false
DAT_WORKER_SECRET=
# CRM marks the worker offline when no authenticated queue poll is seen in this window.
DAT_WORKER_STALE_MS=90000
