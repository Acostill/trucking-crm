# First Class Trucking DAT worker configuration.
# Copy this file to .local-secrets/first-class-dat-worker.env at the repository
# root, keep it local, and never commit the populated file. Set DAT_ENV_FILE to
# another absolute path only when the default local secret path is unsuitable.

# Required absolute directory for the dedicated Playwright Chrome profile.
# Keep this outside the repository so DAT can remember the device for 30 days.
DAT_USER_DATA_DIR=/absolute/path/outside/the/repository/first-class-dat-profile

# Optional runtime overrides. Usage is recorded for audit, with no application daily cap.
DAT_TIMEZONE=America/New_York
DAT_HEADLESS=0
DAT_SHARED_SESSION_LOGIN_ANYWAY=1
DAT_HUMAN_AUTH_TIMEOUT_MS=300000
DAT_RESULT_TIMEOUT_MS=30000
DAT_RETENTION_DAYS=30

# Traces can expose lane/rate data and are disabled by default.
DAT_CAPTURE_TRACE=0

# Local runs default to installed Google Chrome. Railway uses Chromium from
# the pinned Playwright image.
DAT_BROWSER_CHANNEL=chrome

# Railway-only modes: auth exposes a temporary browser desktop for human
# DAT/MFA login; worker runs the unattended queue afterward.
DAT_SERVICE_MODE=worker
# Traditional VNC authentication accepts exactly 8 characters.
DAT_VNC_PASSWORD=Ab12Cd34

# CRM queue connection. Use the same strong secret on Render and this Mac.
# Never add this secret to the React/client environment.
DAT_CRM_BASE_URL=https://your-crm-backend.example.com
DAT_WORKER_SECRET=replace-with-a-long-random-secret
DAT_WORKER_ID=first-class-dat-worker
DAT_WORKER_POLL_INTERVAL_MS=5000
